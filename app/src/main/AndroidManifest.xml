<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VehicleRent">

        <!-- Screen 1: Beranda Fleet (Launcher) -->
        <activity
            android:name=".BerandaFleetActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Form Pemesanan Mobil -->
        <activity
            android:name=".FormPemesananActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Detail Reservasi & Implicit Intent -->
        <activity
            android:name=".DetailReservasiActivity"
            android:exported="false" />

        <!-- Screen 4: Inspeksi Pick-up / Serah Terima -->
        <activity
            android:name=".InspeksiPickUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 5: Inspeksi Return & Estimasi Bengkel Internal -->
        <activity
            android:name=".InspeksiReturnActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Backward Compatibility Entry -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Dual-Role Workshop Admin: Antrean Stall Bengkel -->
        <activity
            android:name=".StallBengkelActivity"
            android:exported="false" />

        <!-- Dual-Role Workshop Admin: Kamus & Diagnostik OBD-II SAE J2012 -->
        <activity
            android:name=".ObdDiagnosticActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
