<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_slate_50"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface_white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_slate_900" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.HeadingLG"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kamus &amp; Mesin OBD-II" />

            <TextView
                style="@style/TextAppearance.LabelCaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STANDAR SAE J2012 &amp; FLAT-RATE BENGKEL"
                android:textColor="@color/workshop_amber_dark" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnToolbarProfile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_card_amber"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="@color/workshop_amber_dark" />
        </FrameLayout>
    </LinearLayout>

    <!-- Role Indicator Banner -->
    <include layout="@layout/include_role_banner" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Interactive Live Parser Simulator Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_amber"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.LabelCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIMULATOR SAE J2012 PARSER &amp; KALKULATOR LIVE"
                    android:textColor="@color/workshop_amber_dark" />

                <!-- Search / Code Input Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_terminal"
                        app:tint="@color/workshop_amber_dark" />

                    <EditText
                        android:id="@+id/etObdSearchInput"
                        style="@style/TextAppearance.MonoDataLG"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="Ketik kode OBD-II (misal: P0300, C0035, U0100)..."
                        android:inputType="textCapCharacters"
                        android:letterSpacing="0.06"
                        android:text="P0300" />
                </LinearLayout>

                <!-- Decomposition Telemetry Box -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_surface"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvParsedSystemTitle"
                        style="@style/TextAppearance.HeadingMD"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Powertrain (Mesin &amp; Transmisi)"
                        android:textColor="@color/primary_navy"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvParsedDescription"
                        style="@style/TextAppearance.BodySM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Random/Multiple Cylinder Misfire Detected"
                        android:textColor="@color/text_slate_900"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvParsedAction"
                        style="@style/TextAppearance.BodySM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tindakan: Ignition Coil Pack &amp; Spark Plug Set"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/card_border" />

                    <!-- Decomposition Digits -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDigit1Dec"
                            style="@style/TextAppearance.LabelCaps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="D1: P (Powertrain)"
                            android:textColor="@color/workshop_amber_dark" />

                        <TextView
                            android:id="@+id/tvDigit2Dec"
                            style="@style/TextAppearance.LabelCaps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="D2: 0 (SAE Std)"
                            android:textColor="@color/primary_navy" />

                        <TextView
                            android:id="@+id/tvDigit3Dec"
                            style="@style/TextAppearance.LabelCaps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="D3: 3 (Ignition)" />
                    </LinearLayout>

                    <!-- Rate & Severity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvParsedHours"
                            style="@style/TextAppearance.MonoDataSM"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Estimasi: 2.0 Jam"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvParsedCost"
                            style="@style/TextAppearance.MonoDataSM"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Suku Cadang: Rp 450.000"
                            android:textColor="@color/status_workshop_text"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Filter Segmented Tabs: P, C, B, U -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_segmented_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnFilterAll"
                    style="@style/TextAppearance.LabelCaps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Semua"
                    android:textColor="@color/white"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/btnFilterP"
                    style="@style/TextAppearance.LabelCaps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="P (Mesin)"
                    android:textColor="@color/text_slate_600"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/btnFilterC"
                    style="@style/TextAppearance.LabelCaps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="C (Sasis)"
                    android:textColor="@color/text_slate_600"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/btnFilterB"
                    style="@style/TextAppearance.LabelCaps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="B (Bodi)"
                    android:textColor="@color/text_slate_600"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/btnFilterU"
                    style="@style/TextAppearance.LabelCaps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="U (Jaringan)"
                    android:textColor="@color/text_slate_600"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- DTC Codes List -->
            <TextView
                android:id="@+id/tvDictionaryCount"
                style="@style/TextAppearance.LabelCaps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="DATASET STANDAR SAE J2012 (24 KODE)" />

            <LinearLayout
                android:id="@+id/llDtcListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include layout="@layout/include_bottom_nav" />

</LinearLayout>

