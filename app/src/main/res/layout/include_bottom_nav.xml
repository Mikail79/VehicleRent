<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@color/surface_white"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/navBeranda"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavBeranda"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_directions_car"
            app:tint="@color/primary_navy" />

        <TextView
            android:id="@+id/tvNavBeranda"
            style="@style/TextAppearance.LabelCaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Beranda"
            android:textColor="@color/primary_navy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navReservasi"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavReservasi"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_calendar_month"
            app:tint="@color/text_slate_400" />

        <TextView
            android:id="@+id/tvNavReservasi"
            style="@style/TextAppearance.LabelCaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Reservasi"
            android:textColor="@color/text_slate_400" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navInspeksi"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavInspeksi"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_assignment_turned_in"
            app:tint="@color/text_slate_400" />

        <TextView
            android:id="@+id/tvNavInspeksi"
            style="@style/TextAppearance.LabelCaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Inspeksi"
            android:textColor="@color/text_slate_400" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navBengkel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavBengkel"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_build_circle"
            app:tint="@color/text_slate_400" />

        <TextView
            android:id="@+id/tvNavBengkel"
            style="@style/TextAppearance.LabelCaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Bengkel"
            android:textColor="@color/text_slate_400" />
    </LinearLayout>

</LinearLayout>

