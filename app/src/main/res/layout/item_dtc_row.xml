<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_surface"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDtcCode"
            style="@style/TextAppearance.MonoDataLG"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_plate"
            android:letterSpacing="0.08"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="P0300"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDtcSystemCategory"
            style="@style/TextAppearance.LabelCaps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Powertrain • Ignition &amp; Misfire"
            android:textColor="@color/workshop_amber_dark" />

        <TextView
            android:id="@+id/tvDtcSeverity"
            style="@style/TextAppearance.LabelCaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_workshop"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="CRITICAL"
            android:textColor="@color/status_workshop_text"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDtcDescription"
        style="@style/TextAppearance.BodyMD"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Random/Multiple Cylinder Misfire Detected"
        android:textColor="@color/text_slate_900"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDtcAction"
        style="@style/TextAppearance.BodySM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Rekomendasi: Ignition Coil Pack &amp; Spark Plug Set"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDtcHours"
            style="@style/TextAppearance.MonoDataSM"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Flat-Rate: 2.0 Jam"
            android:textColor="@color/workshop_amber_dark"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDtcCost"
            style="@style/TextAppearance.MonoDataSM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suku Cadang: Rp 450.000"
            android:textColor="@color/text_slate_900" />
    </LinearLayout>

</LinearLayout>

