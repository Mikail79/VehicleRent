<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Far Left: Compact 54dp Vehicle Photo Thumbnail -->
    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_card_container_low"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/ivRowVehicleImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/photo_car_zenix" />
    </FrameLayout>

    <!-- Center: Vehicle Telemetry Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Plate & Status Tag Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRowPlateNumber"
                style="@style/TextAppearance.MonoDataMD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_plate"
                android:letterSpacing="0.06"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="B 1842 KZR"
                android:textSize="11sp" />

            <!-- Telemetry Status Chip -->
            <LinearLayout
                android:id="@+id/llRowStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_telemetry_tag"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/ivRowStatusIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/status_ready_text" />

                <TextView
                    android:id="@+id/tvRowStatusText"
                    style="@style/TextAppearance.LabelCaps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.04"
                    android:text="SIAP OPERASI"
                    android:textColor="@color/status_ready_text"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vehicle Name (1 line truncated) -->
        <TextView
            android:id="@+id/tvRowVehicleName"
            style="@style/TextAppearance.HeadingMD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Toyota Kijang Innova Zenix 2.0 G CVT"
            android:textSize="12.5sp" />

        <!-- Sub-Telemetry: Staging Bay, Odometer, Fuel -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRowStagingBay"
                style="@style/TextAppearance.BodySM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bay B-04"
                android:textColor="@color/primary_navy"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.BodySM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:text="•"
                android:textColor="@color/text_slate_400"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvRowOdometer"
                style="@style/TextAppearance.MonoDataSM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24.120 km"
                android:textColor="@color/text_slate_600"
                android:textSize="10sp" />

            <TextView
                style="@style/TextAppearance.BodySM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:text="•"
                android:textColor="@color/text_slate_400"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvRowFuel"
                style="@style/TextAppearance.MonoDataSM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BBM: 100%"
                android:textColor="@color/text_slate_600"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right: Thumb-Zone 1-Tap Action Button -->
    <Button
        android:id="@+id/btnRowAction"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_button_primary"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.04"
        android:minHeight="34dp"
        android:paddingHorizontal="10dp"
        android:text="Alokasi ↗"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
