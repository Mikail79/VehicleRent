<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VehicleRent" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryDark">@color/primary_navy_dark</item>
        <item name="colorSecondary">@color/workshop_amber</item>
        <item name="android:statusBarColor">@color/bg_slate_50</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_slate_50</item>
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
    </style>

    <style name="Theme.VehicleRent" parent="Base.Theme.VehicleRent" />

    <!-- Typography Text Styles -->
    <style name="TextAppearance.HeadingXL" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_slate_900</item>
    </style>

    <style name="TextAppearance.HeadingLG" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_slate_900</item>
    </style>

    <style name="TextAppearance.HeadingMD" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_slate_900</item>
    </style>

    <style name="TextAppearance.BodyMD" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_slate_600</item>
    </style>

    <style name="TextAppearance.BodySM" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_slate_600</item>
    </style>

    <style name="TextAppearance.LabelCaps" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_plus_jakarta_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_slate_400</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- JetBrains Mono Technical Telemetry Styles (Tabular Numerals for Fixed-Width Metrics) -->
    <style name="TextAppearance.MonoDataLG" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_jetbrains_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_slate_900</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.MonoDataMD" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_jetbrains_mono</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_slate_900</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="TextAppearance.MonoDataSM" parent="android:TextAppearance">
        <item name="fontFamily">@font/font_jetbrains_mono</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_slate_600</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>
